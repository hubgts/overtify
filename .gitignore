# Dépendances
node_modules/

# Artefacts de build
dist/
build/
*.tsbuildinfo

# JavaScript compilé égaré dans les sources : un `tsc` sans --noEmit en produit
# à côté des .ts, ce qui fait exécuter chaque test en double.
frontend/src/**/*.js
frontend/src/**/*.js.map
backend/src/**/*.js
backend/src/**/*.js.map
frontend/vite.config.js
backend/vitest.config.js
frontend/vitest.config.js

# Configuration locale — contient le client secret Spotify
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# Couverture de tests
coverage/

# Éditeurs et OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Journaux d exécution
logs/

# Données applicatives locales (mémoire de qualification hors conteneur)
data/
