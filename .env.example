# ==============================================================================
# Overtify — configuration
#
# Copiez ce fichier vers `.env` (ou lancez `make init`, qui le fait pour vous
# et génère un SESSION_SECRET aléatoire).
#
# Le fichier `.env` contient un secret : il est ignoré par Git et ne doit
# jamais être committé.
# ==============================================================================

# ------------------------------------------------------------------------------
# Identifiants Spotify
#
# À récupérer sur https://developer.spotify.com/dashboard après avoir créé une
# application. Procédure détaillée pas à pas : docs/SPOTIFY_SETUP.md
# ------------------------------------------------------------------------------

# « Client ID » affiché sur la page de votre application.
SPOTIFY_CLIENT_ID=

# « Client secret » (bouton « View client secret »).
# Ce secret reste côté backend et n'est JAMAIS transmis au navigateur.
SPOTIFY_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# URLs
#
# IMPORTANT : SPOTIFY_REDIRECT_URI doit être déclarée à l'identique, caractère
# pour caractère, dans les « Redirect URIs » de votre application Spotify.
# La moindre différence (port, slash final, http/https) provoque l'erreur
# INVALID_CLIENT: Invalid redirect URI.
#
# On utilise 127.0.0.1 et NON localhost : depuis avril 2025, Spotify refuse
# `localhost` dans les Redirect URIs et impose l'IP littérale.
#
# Conséquence : ouvrez l'application sur http://127.0.0.1:8080 et non sur
# http://localhost:8080. Pour le navigateur ce sont deux origines distinctes,
# et le cookie de session déposé sur l'une n'est pas envoyé à l'autre.
#
#   - Docker (make up)  : http://127.0.0.1:8080/api/auth/callback
#   - Développement npm : http://127.0.0.1:3001/api/auth/callback
# ------------------------------------------------------------------------------

SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/api/auth/callback

# Origine du frontend : sert au CORS et à la redirection après connexion.
#   - Docker (make up)  : http://127.0.0.1:8080
#   - Développement npm : http://127.0.0.1:5173
FRONTEND_URL=http://127.0.0.1:8080

# ------------------------------------------------------------------------------
# Sécurité
# ------------------------------------------------------------------------------

# Clé de signature des cookies de session : 32 caractères minimum.
# `make init` en génère une automatiquement. Sinon :
#   openssl rand -hex 32
SESSION_SECRET=

# ------------------------------------------------------------------------------
# Ports (optionnel)
# ------------------------------------------------------------------------------

# Port exposé par le frontend en Docker.
FRONTEND_PORT=8080

# ------------------------------------------------------------------------------
# Débogage (optionnel)
# ------------------------------------------------------------------------------

# Journal des échanges avec l'API Spotify (requêtes et réponses brutes).
# Très utile quand une réponse Spotify ne correspond pas à la documentation.
# Laisser vide pour désactiver. En Docker, le fichier apparaît dans ./logs/.
#   SPOTIFY_LOG_FILE=/app/logs/spotify-api.log
SPOTIFY_LOG_FILE=
